# Environment variables template for Go Service Driver
# Copy this file to .env and fill in the actual values

DB_USER=
DB_PASS=
DB_HOST=mysql
DB_PORT=3306
DB_NAME=trip_planner

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=trip_planner

REDIS_HOST=redis
REDIS_PORT=6379

JWT_KEY=trip_planner_secret_key
MAIL_API_KEY=
DOMAIN=onboarding@resend.dev

SERVER_PORT=:8080

# When TEST_MODE is true, the application will use mock services for testing purposes
TEST_MODE=false

AMAP_API_KEY=
AMAP_API_URL=https://restapi.amap.com